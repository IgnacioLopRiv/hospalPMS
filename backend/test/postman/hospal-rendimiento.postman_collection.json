{
  "info": {
    "name": "HosPal PMS - Rendimiento",
    "description": "Colección para pruebas de rendimiento de la API de HosPal PMS. La carpeta 'Consultas frecuentes' solo usa endpoints GET, por lo que se puede ejecutar con muchos usuarios virtuales sin modificar datos. La carpeta 'Operaciones pesadas' contiene el login (bcrypt) y la generación de PDF, que consumen más CPU y se prueban con menos usuarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// RF-07: la API exige JWT. Inicia sesión una vez y reutiliza el token.",
          "const esAuth = pm.request.url.toString().includes('/auth/');",
          "const usarToken = (t) => pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + t });",
          "const guardado = pm.collectionVariables.get('accessToken');",
          "if (!esAuth && guardado) {",
          "  usarToken(guardado);",
          "} else if (!esAuth) {",
          "  pm.sendRequest({",
          "    url: pm.variables.replaceIn('{{baseUrl}}/auth/login'),",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ email: pm.variables.replaceIn('{{loginEmail}}'), password: pm.variables.replaceIn('{{loginPassword}}') }) },",
          "  }, (err, res) => {",
          "    if (!err && res.code === 200) {",
          "      const t = res.json().accessToken;",
          "      pm.collectionVariables.set('accessToken', t);",
          "      usarToken(t);",
          "    }",
          "  });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Responde sin error (2xx)', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});",
          "",
          "const limite = Number(pm.environment.get('maxResponseMs') || 1000);",
          "pm.test('Tiempo de respuesta menor a ' + limite + ' ms', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(limite);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Consultas frecuentes",
      "item": [
        {
          "name": "Listar sedes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sedes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sedes"
              ]
            }
          }
        },
        {
          "name": "Habitaciones de la sede",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sedes/{{sedeId}}/habitaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sedes",
                "{{sedeId}}",
                "habitaciones"
              ]
            }
          }
        },
        {
          "name": "Reservas de la sede",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservas?sedeId={{sedeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservas"
              ],
              "query": [
                {
                  "key": "sedeId",
                  "value": "{{sedeId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Huéspedes de la sede",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/huespedes?sedeId={{sedeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "huespedes"
              ],
              "query": [
                {
                  "key": "sedeId",
                  "value": "{{sedeId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Tarifas de la sede",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sedes/{{sedeId}}/tarifas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sedes",
                "{{sedeId}}",
                "tarifas"
              ]
            }
          }
        },
        {
          "name": "Resumen del dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reportes/resumen?sedeId={{sedeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reportes",
                "resumen"
              ],
              "query": [
                {
                  "key": "sedeId",
                  "value": "{{sedeId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Operaciones pesadas",
      "item": [
        {
          "name": "Login funcionario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Reporte PDF del mes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reportes/pdf?sedeId={{sedeId}}&desde={{pdfDesde}}&hasta={{pdfHasta}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reportes",
                "pdf"
              ],
              "query": [
                {
                  "key": "sedeId",
                  "value": "{{sedeId}}"
                },
                {
                  "key": "desde",
                  "value": "{{pdfDesde}}"
                },
                {
                  "key": "hasta",
                  "value": "{{pdfHasta}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
