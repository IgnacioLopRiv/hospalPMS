# Base de datos
PORT=3000
DATABASE_URL="mysql://hospal_user:hospaldb123@localhost:3307/hospalDB"

DB_ROOT_PASSWORD=root1234
DB_NAME=hospalDB
DB_USER=hospal_user
DB_PASS=hospaldb123

# =============================================================================
# CONFIGURACIÓN DE NOTIFICACIONES POR CORREO (SMTP)
# =============================================================================

# Remitente principal mostrado al huésped
MAIL_FROM="HosPal PMS <no-reply@hospal.local>"

# -----------------------------------------------------------------------------
# OPCIÓN A (Recomendada en desarrollo): Mailpit local (captura correos sin enviar al exterior)
# Interfaz web para ver correos en http://localhost:8025
# -----------------------------------------------------------------------------
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASS=""

# -----------------------------------------------------------------------------
# OPCIÓN B: Brevo (Plan Gratuito 300 correos/día sin comprar dominio)
# Registrarse gratis en brevo.com, verificar un remitente individual y usar SMTP:
# -----------------------------------------------------------------------------
# MAIL_HOST="smtp-relay.brevo.com"
# MAIL_PORT=587
# MAIL_SECURE="false"
# MAIL_USER="tu-login-smtp@brevo.com"
# MAIL_PASS="tu-clave-smtp-brevo"
# MAIL_FROM="Hostal Demo <tu-correo-verificado@gmail.com>"

# -----------------------------------------------------------------------------
# OPCIÓN C: Gmail con Contraseña de Aplicación
# Activar 2FA en Google y generar "Contraseña de aplicaciones":
# -----------------------------------------------------------------------------
# MAIL_HOST="smtp.gmail.com"
# MAIL_PORT=465
# MAIL_SECURE="true"
# MAIL_USER="tu-correo@gmail.com"
# MAIL_PASS="tu-clave-de-aplicacion-de-16-caracteres"
# MAIL_FROM="HosPal <tu-correo@gmail.com>"

# =============================================================================
# TERMINALES DE PAGO (POS)
# =============================================================================
# Clave para cifrar las credenciales de los proveedores POS guardadas en la BD
# (mínimo 16 caracteres). Si se cambia, hay que volver a ingresar las credenciales.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POS_ENCRYPTION_KEY=""
