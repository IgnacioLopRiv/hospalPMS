generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RolFuncionario {
  ADMINISTRADOR
  RECEPCIONISTA
  PERSONAL_LIMPIEZA
}

enum EstadoHabitacion {
  DISPONIBLE
  RESERVADA
  OCUPADA
  EN_LIMPIEZA
  MANTENIMIENTO
}

enum EstadoReserva {
  CONFIRMADA
  EN_CURSO
  FINALIZADA
  CANCELADA
}

enum MetodoPago {
  TRANSFERENCIA
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
}

enum TipoOperacion {
  ABONO
  PAGO_FINAL
  PAGO_SERVICIO_ADICIONAL
  REEMBOLSO
}

enum TipoTemporada {
  ALTA
  BAJA
}

enum TipoDocumento {
  BOLETA
  FACTURA
  NOTA_CREDITO
}

enum EstadoSii {
  PENDIENTE
  ENVIADO
  ACEPTADO
  RECHAZADO
}

enum TipoNotificacionEmail {
  CONFIRMACION_RESERVA
  COMPROBANTE_PAGO
  RECORDATORIO_PRE_LLEGADA
  RESUMEN_CHECKOUT
}

enum EstadoNotificacionEmail {
  PENDIENTE
  ENVIADA
  FALLIDA
}

model Hostal {
  id             Int     @id @default(autoincrement())
  rutEmpresa     String  @unique @db.VarChar(12)
  razonSocial    String
  nombreFantasia String
  giro           String
  direccion      String
  email          String? @db.VarChar(191)
  logoUrl        String? @db.VarChar(500)
  sedes          Sede[]

  @@map("hostal")
}

model Sede {
  id                  Int                @id @default(autoincrement())
  hostalId            Int
  nombreSede          String
  direccion           String
  ciudad              String
  telefono            String?            @db.VarChar(20)
  email               String?            @db.VarChar(191)
  horaCheckIn         String?            @default("15:00") @db.VarChar(10)
  horaCheckOut        String?            @default("12:00") @db.VarChar(10)
  politicaCancelacion String?            @db.Text
  serviciosIncluidos  String?            @db.Text
  urlEncuesta         String?            @db.VarChar(500)
  sitioWeb            String?            @db.VarChar(500)
  hostal              Hostal             @relation(fields: [hostalId], references: [id])
  funcionarios        Funcionario[]
  habitaciones        Habitacion[]
  tipologias          Tipologia[]
  insumos             InsumoInventario[]
  tarifaAbono         TarifaAbono?
  tarifas             Tarifa[]
  huespedes           Huesped[]
  configuracionPos    ConfiguracionPos?

  @@map("sede")
}

model Funcionario {
  id           Int            @id @default(autoincrement())
  sedeId       Int
  rut          String         @unique @db.VarChar(12)
  nombres      String
  apellidos    String
  email        String         @unique
  passwordHash String         @db.VarChar(255)
  rol          RolFuncionario
  sede         Sede           @relation(fields: [sedeId], references: [id])

  @@map("funcionario")
}

model Tipologia {
  id              Int                       @id @default(autoincrement())
  sedeId          Int
  nombre          String
  capacidadMax    Int
  numCamas        Int
  descripcion     String?                   @db.Text
  color           String?                   @db.VarChar(7)
  precioBase      Int?
  sede            Sede                      @relation(fields: [sedeId], references: [id])
  habitaciones    Habitacion[]
  preciosTarifa   TarifaTipologia[]
  caracteristicas TipologiaCaracteristica[]

  @@unique([sedeId, nombre])
  @@map("tipologia")
}

model Caracteristica {
  id         Int                       @id @default(autoincrement())
  nombre     String
  icono      String?
  activo     Boolean                   @default(true)
  tipologias TipologiaCaracteristica[]

  @@map("caracteristica")
}

model TipologiaCaracteristica {
  tipologiaId      Int
  caracteristicaId Int
  tipologia        Tipologia      @relation(fields: [tipologiaId], references: [id])
  caracteristica   Caracteristica @relation(fields: [caracteristicaId], references: [id])

  @@id([tipologiaId, caracteristicaId])
  @@map("tipologia_caracteristica")
}

model Tarifa {
  id            Int               @id @default(autoincrement())
  sedeId        Int
  tarifaAbonoId Int
  nombre        String
  precioBase    Int?
  fechaInicio   DateTime?         @db.Date
  fechaFin      DateTime?         @db.Date
  tipoTemporada TipoTemporada
  activa        Boolean           @default(true)
  periodos      Json
  sede          Sede              @relation(fields: [sedeId], references: [id])
  tarifaAbono   TarifaAbono       @relation(fields: [tarifaAbonoId], references: [id])
  precios       TarifaTipologia[]

  @@index([sedeId, fechaInicio, fechaFin])
  @@map("tarifa")
}

model TarifaTipologia {
  tarifaId    Int
  tipologiaId Int
  precio      Int
  tarifa      Tarifa    @relation(fields: [tarifaId], references: [id], onDelete: Cascade)
  tipologia   Tipologia @relation(fields: [tipologiaId], references: [id], onDelete: Cascade)

  @@id([tarifaId, tipologiaId])
  @@map("tarifa_tipologia")
}

model Habitacion {
  id                 Int                    @id @default(autoincrement())
  sedeId             Int
  tipologiaId        Int
  numero             String                 @db.VarChar(10)
  estado             EstadoHabitacion       @default(DISPONIBLE)
  cantidadPersonas   Int
  tamanoM2           Float?
  disposicionMuebles String?
  descripcion        String?                @db.Text
  huespedActual      String?
  aseoIniciado       DateTime?
  activa             Boolean                @default(true)
  sede               Sede                   @relation(fields: [sedeId], references: [id])
  tipologia          Tipologia              @relation(fields: [tipologiaId], references: [id])
  reservas           Reserva[]
  inventario         InventarioHabitacion[]
  fotos              FotoHabitacion[]

  @@unique([sedeId, numero])
  @@map("habitacion")
}

model TarifaAbono {
  id              Int      @id @default(autoincrement())
  sedeId          Int      @unique
  porcentajeAbono Int      @default(20)
  sede            Sede     @relation(fields: [sedeId], references: [id])
  tarifas         Tarifa[]

  @@map("tarifa_abono")
}

model InsumoInventario {
  id          Int                    @id @default(autoincrement())
  sedeId      Int
  nombre      String
  descripcion String?                @db.Text
  costoCompra Int
  stockActual Int
  stockMinimo Int
  activo      Boolean                @default(true)
  sede        Sede                   @relation(fields: [sedeId], references: [id])
  asignados   InventarioHabitacion[]

  @@map("insumo_inventario")
}

model InventarioHabitacion {
  id              Int              @id @default(autoincrement())
  insumoId        Int
  habitacionId    Int
  cantidad        Int
  estado          String           @db.VarChar(30)
  fechaAsignacion DateTime         @default(now())
  insumo          InsumoInventario @relation(fields: [insumoId], references: [id])
  habitacion      Habitacion       @relation(fields: [habitacionId], references: [id])

  @@index([insumoId, estado])
  @@index([habitacionId, estado])
  @@map("inventario_habitacion")
}

model FotoHabitacion {
  id          Int        @id @default(autoincrement())
  habitacionId Int
  url         String     @db.Text
  titulo      String?    @db.VarChar(255)
  descripcion String?    @db.Text
  fechaSubida DateTime   @default(now())
  habitacion  Habitacion @relation(fields: [habitacionId], references: [id], onDelete: Cascade)

  @@index([habitacionId, fechaSubida])
  @@map("foto_habitacion")
}

model Huesped {
  id                 Int       @id @default(autoincrement())
  sedeId             Int
  rutPasaporte       String    @db.VarChar(20)
  nombres            String
  apellidos          String
  paisResidencia     String
  email              String
  telefono           String    @db.VarChar(20)
  esRecurrente       Boolean   @default(false)
  diasUltimoRegistro Int?
  eliminadoEn        DateTime?
  sede              Sede      @relation(fields: [sedeId], references: [id])
  reservas           Reserva[]

  @@unique([sedeId, rutPasaporte])
  @@index([sedeId])
  @@map("huesped")
}

model Reserva {
  id               Int                    @id @default(autoincrement())
  codigo           String?                @unique @db.VarChar(30)
  huespedId        Int
  habitacionId     Int
  fechaReserva     DateTime               @default(now())
  fechaCheckIn     DateTime
  fechaCheckOut    DateTime
  horaLlegada      String?                @db.VarChar(5)
  horaSalida       String?                @default("12:00") @db.VarChar(5)
  cantidadPersonas Int                    @default(1)
  precioTotal      Int?
  porcentajeAbono  Int?
  montoPagado      Int?
  metodoPago       MetodoPago?
  pagoCompleto     Boolean                @default(false)
  estado           EstadoReserva          @default(CONFIRMADA)
  huesped          Huesped                @relation(fields: [huespedId], references: [id])
  habitacion       Habitacion             @relation(fields: [habitacionId], references: [id])
  pagos            Pago[]
  transaccionesPos TransaccionPos[]
  documentos       DocumentoFacturacion[]
  notificaciones   NotificacionEmail[]

  @@index([habitacionId, fechaCheckIn, fechaCheckOut])
  @@map("reserva")
}

model Pago {
  id             Int                 @id @default(autoincrement())
  referencia     String?             @unique @db.VarChar(50)
  reservaId      Int
  monto          Int
  metodoPago     MetodoPago
  tipoOperacion  TipoOperacion
  fechaPago      DateTime            @default(now())
  reserva        Reserva             @relation(fields: [reservaId], references: [id])
  notificaciones NotificacionEmail[]
  transaccionPos TransaccionPos?

  @@map("pago")
}

model DocumentoFacturacion {
  id            Int           @id @default(autoincrement())
  reservaId     Int
  tipoDocumento TipoDocumento
  folioSii      Int?
  montoNeto     Int
  montoIva      Int
  montoTotal    Int
  fechaEmision  DateTime
  estadoSii     EstadoSii     @default(PENDIENTE)
  reserva       Reserva       @relation(fields: [reservaId], references: [id])

  @@unique([tipoDocumento, folioSii])
  @@map("documento_facturacion")
}

model NotificacionEmail {
  id            Int                     @id @default(autoincrement())
  tipo          TipoNotificacionEmail
  reservaId     Int
  pagoId        Int?
  destinatario  String                  @db.VarChar(191)
  idioma        String                  @default("es") @db.VarChar(5)
  asunto        String                  @db.VarChar(255)
  estado        EstadoNotificacionEmail @default(PENDIENTE)
  intentos      Int                     @default(0)
  ultimoError   String?                 @db.Text
  enviadoAt     DateTime?
  creadoAt      DateTime                @default(now())
  actualizadoAt DateTime                @updatedAt
  reserva       Reserva                 @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  pago          Pago?                   @relation(fields: [pagoId], references: [id], onDelete: SetNull)

  @@index([reservaId, tipo])
  @@map("notificacion_email")
}

/// Configuración del terminal de pago (POS) de una sede.
/// `proveedor` es el código de un adaptador registrado en el backend
/// (p. ej. MERCADO_PAGO_POINT, MANUAL); es texto libre para poder agregar
/// proveedores sin migrar la base de datos.
model ConfiguracionPos {
  id            Int      @id @default(autoincrement())
  sedeId        Int      @unique
  proveedor     String   @db.VarChar(50)
  activo        Boolean  @default(false)
  /// Credenciales del proveedor cifradas con AES-256-GCM (POS_ENCRYPTION_KEY).
  credenciales  String?  @db.Text
  /// Parámetros no sensibles (dispositivo, modo de prueba, etc.).
  parametros    Json?
  creadoAt      DateTime @default(now())
  actualizadoAt DateTime @updatedAt
  sede          Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@map("configuracion_pos")
}

enum EstadoTransaccionPos {
  /// Creada en HosPal; aún no confirmada por el proveedor.
  PENDIENTE
  /// El terminal tomó el cobro y espera la tarjeta.
  EN_TERMINAL
  APROBADA
  RECHAZADA
  CANCELADA
  EXPIRADA
  REEMBOLSADA
  /// Falló la comunicación con el proveedor al crear el cobro.
  ERROR
}

/// Cobro enviado a un terminal POS. Cuando el proveedor lo aprueba se crea
/// el Pago correspondiente (pagoId).
model TransaccionPos {
  id                Int                  @id @default(autoincrement())
  reservaId         Int
  sedeId            Int
  pagoId            Int?                 @unique
  proveedor         String               @db.VarChar(50)
  /// ID del cobro en el proveedor (p. ej. ORD... en Mercado Pago).
  externalId        String?              @db.VarChar(100)
  externalReference String?              @unique @db.VarChar(64)
  deviceId          String?              @db.VarChar(100)
  monto             Int
  tipoOperacion     TipoOperacion
  estado            EstadoTransaccionPos @default(PENDIENTE)
  estadoDetalle     String?              @db.VarChar(100)
  metodoPago        MetodoPago?
  mensaje           String?              @db.VarChar(500)
  respuestaRaw      Json?
  creadoAt          DateTime             @default(now())
  actualizadoAt     DateTime             @updatedAt
  reserva           Reserva              @relation(fields: [reservaId], references: [id])
  pago              Pago?                @relation(fields: [pagoId], references: [id], onDelete: SetNull)

  @@unique([proveedor, externalId])
  @@index([sedeId, estado])
  @@map("transaccion_pos")
}
